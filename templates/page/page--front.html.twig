{#
/**
 * @file
 * Montinuity - Front Page
 * Clean, focused home page
 */
#}

{{ attach_library('dungeoncrawler/animated-header') }}

{% set primary_cta_url = '/campaigns' %}
{% set primary_cta_label = 'Launch a Shard Campaign' %}
{% if not logged_in %}
  {% set primary_cta_url = '/user/login?destination=/campaigns' %}
  {% set primary_cta_label = 'Sign In to Launch a Shard' %}
{% endif %}
{% set secondary_cta_url = '/world' %}
{% set secondary_cta_label = 'See the Living Multiverse' %}

<div class="page-wrapper">
  {# Hero Section #}
  <div id="large-header" class="large-header home-header">
    <canvas id="demo-canvas"></canvas>
    <h1 class="main-title">
      <span class="highlight">Montinuity</span>
    </h1>
    <p class="main-subtitle">
      A shard-based multiverse where campaigns persist, timelines fork, and characters can cross into new settings without losing who they are.
    </p>
    <div class="hero-cta">
      <a href="{{ primary_cta_url }}" class="btn btn-primary">{{ primary_cta_label }}</a>
      <a href="{{ secondary_cta_url }}" class="btn btn-outline-light">{{ secondary_cta_label }}</a>
    </div>
  </div>

  {# Navigation #}
  {% block page_navigation %}
    {% embed 'radix:navbar' with {
      navbar_container_type: null,
      navbar_expand: 'lg',
      navbar_theme: 'dark',
      navbar_utility_classes: ['dungeoncrawler-navbar'],
    } %}
      {% block branding %}
        {% if page.navbar_branding %}
          {{ page.navbar_branding }}
        {% endif %}
      {% endblock %}
      {% block left %}
        {% if page.navbar_left %}
          <div class="me-auto">
            {{ page.navbar_left }}
          </div>
        {% endif %}
      {% endblock %}
      {% block right %}
        {% if page.navbar_right %}
          {{ attach_library('dungeoncrawler/navbar_right') }}
          <div class="ms-auto region-navbar-right">
            {{ page.navbar_right }}
          </div>
        {% endif %}
      {% endblock %}
    {% endembed %}
  {% endblock %}

  {# Main Content #}
  <main class="main-content">
    <div class="container">

      {# Key Features - Simple 3-Column #}
      <section class="features-section">
        <div class="features-grid">
          <div class="feature-card">
            <h3>Shard Campaigns</h3>
            <p>Every campaign is its own persistent universe shard with local history, consequences, and room to become meaningfully different from every other run.</p>
          </div>
          <div class="feature-card">
            <h3>Forked Characters</h3>
            <p>Characters are treated like evolving agents: they can persist, be restored, diverge across timelines, and keep building identity over many sessions.</p>
          </div>
          <div class="feature-card">
            <h3>Cross-Setting Travel</h3>
            <p>Move a character from classic fantasy into cyberpunk, planar, or stranger shards as part of the fiction instead of treating it like an out-of-band import.</p>
          </div>
        </div>
      </section>

      {# Quick Stats #}
      <section class="stats-section">
        <div class="stats-row">
          <div class="stat-item">
            <span class="stat-number">∞</span>
            <span class="stat-label">Shards</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">16</span>
            <span class="stat-label">Classes</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">11</span>
            <span class="stat-label">Ancestries</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">1</span>
            <span class="stat-label">Multiverse</span>
          </div>
        </div>
      </section>

      {# Final CTA #}
      <section class="cta-section">
        <div class="cta-content">
          <h2>Ready to <span class="highlight">Launch</span> a shard?</h2>
          <p>Create a campaign universe, choose a character, and start a history you can continue, restore, branch, or carry into a different setting later.</p>
          <a href="{{ primary_cta_url }}" class="btn btn-primary">{{ primary_cta_label }}</a>
        </div>
      </section>

    </div>
  </main>

  {# Footer #}
  {% if page.footer %}
    {{ page.footer }}
  {% endif %}
</div>
